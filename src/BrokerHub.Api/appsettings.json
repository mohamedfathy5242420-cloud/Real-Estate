{
  "BrokerHub": {
    "ApplicationName": "BrokerHub"
  },
  "IdentityLinks": {
    "FrontendBaseUrl": "https://localhost:4200"
  },
  "ApiSecurity": {
    "FrontendOrigins": ["https://localhost:4200"]
  },
  "DevelopmentIdentityCapture": {
    "Enabled": false,
    "RootPath": "",
    "AllowedRecipients": [],
    "MaximumRecords": 256
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OutboxDispatch": {
    "Enabled": false,
    "BatchSize": 20,
    "IntervalSeconds": 5,
    "LeaseSeconds": 180,
    "MaxAttempts": 5,
    "RetryBaseSeconds": 5,
    "RetryMaxSeconds": 300
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/brokerhub",
    "UseTls": false,
    "NamePrefix": "brokerhub",
    "PublishTimeoutSeconds": 5,
    "ConnectTimeoutSeconds": 3,
    "HeartbeatSeconds": 15,
    "MaxQueueLength": 10000,
    "MaxQueueBytes": 67108864,
    "DeliveryLimit": 5
  },
  "NotificationConsumer": {
    "Enabled": false,
    "PrefetchCount": 1,
    "ReconnectSeconds": 3,
    "FailureDelaySeconds": 1,
    "ProcessingTimeoutSeconds": 60,
    "BrokerOperationTimeoutSeconds": 5
  },
  "PublicImageWarmup": {
    "Enabled": false,
    "Capacity": 32,
    "MaximumWaitingOffers": 4,
    "MaximumImagesPerOffer": 3,
    "ProducerWaitMilliseconds": 10,
    "ItemTimeoutSeconds": 10
  },
  "PublicImageCache": {
    "Enabled": true,
    "MaximumBytes": 8388608,
    "MaximumEntries": 32,
    "MaximumEntryBytes": 1048576,
    "LifetimeSeconds": 60
  },
  "LocalNotificationCapture": {
    "Enabled": false,
    "RootPath": "",
    "AllowedAccountIds": []
  },
  "BookingExpiry": {
    "Enabled": true,
    "BatchSize": 100,
    "IntervalSeconds": 30
  },
  "ViewingExpiry": {
    "Enabled": true,
    "BatchSize": 100,
    "IntervalSeconds": 30
  }
}
